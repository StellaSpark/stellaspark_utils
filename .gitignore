*devcontainer-lock.json

# keep all (empty) directories with a .gitkeep file
!.gitkeep

# Claude
# Ignore all CLAUDE.md files...
CLAUDE.md
# ...except the one in the repo root
!/CLAUDE.md
# Ignore Claude Code's per-project config/settings directory...
*.claude/
# ...except the repo-root settings.json, which is checked in so every developer/devcontainer gets the same permission rules (e.g. denying access to .env). 
# Note that settings.local.json (personal overrides) stays ignored.
!/.claude/
/.claude/*
!/.claude/settings.json

# Build distribution side-products
MANIFEST
nul

backups/
*.pyc

# Byte-compiled / optimized / DLL files
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
build/
develop-eggs/
dist/
# downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit- pytest (coverage reports)
htmlcov/
.tox/
.coverage
coverage/
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
pytest_cache/

# Translations
*.mo
*.pot

# Django stuff
*.log
local_settings.py

